{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:akos:schema:casebrain-powerup-federation:1.0.0",
  "title": "CASEBRAIN Powerup Federation Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "federation_id", "generated_at", "governance", "truth_contract", "repositories", "workers", "human_gates", "projection_policy"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "federation_id": {"const": "FAM-CASEBRAIN"},
    "generated_at": {"type": "string", "format": "date-time"},
    "governance": {"$ref": "#/$defs/pin"},
    "truth_contract": {"$ref": "#/$defs/pin"},
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/repository"}
    },
    "workers": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/worker"}
    },
    "human_gates": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["filing", "service", "court_contact", "evidence_release", "publication", "external_escalation", "deadline_confirmation", "fact_promotion", "production_write", "connector_activation"]}
    },
    "projection_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["github", "casebrain", "notion", "clickup", "drive"],
      "properties": {
        "github": {"const": "canonical_contracts_and_code"},
        "casebrain": {"const": "validated_memory_index"},
        "notion": {"const": "navigation_review_and_receipts_only"},
        "clickup": {"const": "manual_execution_visibility_only"},
        "drive": {"const": "source_and_preparation_pointers_not_truth_canon"}
      }
    }
  },
  "$defs": {
    "pin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "ref", "commit_sha", "path"],
      "properties": {
        "repository": {"type": "string", "pattern": "^GlacierEQ/[A-Za-z0-9_.-]+$"},
        "ref": {"type": "string", "minLength": 1},
        "commit_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "path": {"type": "string", "minLength": 1}
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_id", "repository", "role", "visibility", "observed_ref", "observed_commit", "activation_status", "verification_status", "claim_boundary", "allowed_capabilities", "forbidden_capabilities", "gates"],
      "properties": {
        "canonical_id": {"type": "string", "pattern": "^SYS-[A-Z0-9-]+-[0-9]{3}$"},
        "repository": {"type": "string", "pattern": "^GlacierEQ/[A-Za-z0-9_.-]+$"},
        "role": {"type": "string", "minLength": 3},
        "visibility": {"enum": ["private", "public"]},
        "observed_ref": {"type": "string", "minLength": 1},
        "observed_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "activation_status": {"enum": ["review_ready", "repair_proposed", "repair_required", "contract_pending", "sandbox_candidate", "quarantined", "blocked", "hold_distinct", "historical"]},
        "verification_status": {"enum": ["verified_repo_metadata", "verified_files", "verified_code_inspection", "reported_claims_only", "inferred_role"]},
        "claim_boundary": {"type": "string", "minLength": 10},
        "allowed_capabilities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "forbidden_capabilities": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
        "gates": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "related_prs": {"type": "array", "items": {"type": "string", "format": "uri"}}
      }
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["worker_id", "layer", "manager", "capability", "status", "risk_class", "run_mode", "implementation", "read_only", "external_actions", "evidence_mutation_allowed", "input_contracts", "output_contract", "human_gate", "kill_switch"],
      "properties": {
        "worker_id": {"type": "string", "pattern": "^WRK-[A-Z0-9-]+$"},
        "layer": {"enum": ["L0", "L1", "L2", "L3", "L4"]},
        "manager": {"type": "string"},
        "capability": {"type": "string"},
        "status": {"enum": ["design", "dry_run", "verified_live", "paused", "failed", "retired"]},
        "risk_class": {"enum": ["low", "moderate", "high", "critical"]},
        "run_mode": {"enum": ["zero_llm", "single_model", "parallel_inference", "human_only"]},
        "implementation": {"$ref": "#/$defs/pin"},
        "read_only": {"type": "boolean"},
        "external_actions": {"const": false},
        "evidence_mutation_allowed": {"const": false},
        "input_contracts": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "output_contract": {"type": "string"},
        "human_gate": {"type": "string"},
        "kill_switch": {"type": "string", "minLength": 1}
      }
    }
  }
}
