{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/GlacierEQ/AKOS/main/schemas/operational_maturity.schema.json",
  "title": "AKOS-OC-002 Operational Maturity Scorecard",
  "type": "object",
  "required": [
    "scorecard_id",
    "assessed_at",
    "source_refs",
    "capabilities",
    "control_evidence",
    "result"
  ],
  "properties": {
    "scorecard_id": {"type": "string", "minLength": 1},
    "assessed_at": {"type": "string", "format": "date-time"},
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["capability", "state", "source_ref"],
        "properties": {
          "capability": {"type": "string", "minLength": 1},
          "state": {
            "type": "string",
            "enum": [
              "declared",
              "discovered",
              "connected",
              "authenticated",
              "authorized",
              "invoked",
              "returned",
              "verified",
              "persisted"
            ]
          },
          "source_ref": {"type": "string", "minLength": 1},
          "provider_receipt": {"type": ["string", "null"]},
          "artifact_ref": {"type": ["string", "null"]},
          "complete_data": {"type": "boolean", "default": false},
          "timestamp": {"type": "string", "format": "date-time"}
        },
        "additionalProperties": false
      }
    },
    "control_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["control_id", "level", "available", "source_ref"],
        "properties": {
          "control_id": {"type": "string", "minLength": 1},
          "level": {
            "type": "string",
            "enum": ["none", "asserted", "observed", "provider_receipt", "verified", "persisted"]
          },
          "available": {"type": "boolean"},
          "source_ref": {"type": "string", "minLength": 1},
          "provider_receipt": {"type": ["string", "null"]},
          "artifact_ref": {"type": ["string", "null"]},
          "notes": {"type": ["string", "null"]},
          "recorded_at": {"type": "string", "format": "date-time"}
        },
        "additionalProperties": false
      }
    },
    "artifact_closure": {
      "type": "object",
      "required": ["artifact_id", "completed_stages", "ready_for_use"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "completed_stages": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "located",
              "acquired",
              "hashed",
              "preserved",
              "parsed",
              "classified",
              "correlated",
              "drafted",
              "verified",
              "packaged",
              "stored",
              "logged",
              "ready_for_use"
            ]
          }
        },
        "ready_for_use": {"type": "boolean"},
        "missing_stages": {
          "type": "array",
          "items": {"type": "string"}
        },
        "exact_blocker": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "required": [
        "overall_available_ceiling",
        "overall_demonstrated_reliability",
        "gap",
        "dimensions"
      ],
      "properties": {
        "overall_available_ceiling": {"type": "number", "minimum": 0, "maximum": 100},
        "overall_demonstrated_reliability": {"type": "number", "minimum": 0, "maximum": 100},
        "gap": {"type": "number", "minimum": -100, "maximum": 100},
        "dimensions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "dimension",
              "available_ceiling",
              "demonstrated_reliability",
              "band",
              "controls_total",
              "controls_available",
              "controls_satisfied",
              "missing_controls"
            ],
            "properties": {
              "dimension": {"type": "string"},
              "available_ceiling": {"type": "number", "minimum": 0, "maximum": 100},
              "demonstrated_reliability": {"type": "number", "minimum": 0, "maximum": 100},
              "band": {
                "type": "string",
                "enum": ["unassessed", "declared", "observed", "receipt_backed", "verified", "persisted"]
              },
              "controls_total": {"type": "integer", "minimum": 0},
              "controls_available": {"type": "integer", "minimum": 0},
              "controls_satisfied": {"type": "integer", "minimum": 0},
              "missing_controls": {
                "type": "array",
                "items": {"type": "string"}
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
