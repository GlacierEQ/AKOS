{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glaciereq.dev/schemas/resume-master.v1.json",
  "title": "Evidence-Bound Resume Master",
  "type": "object",
  "required": [
    "schema",
    "version",
    "status",
    "facts_invariant",
    "identity",
    "positioning",
    "proof",
    "experience",
    "capabilities",
    "artifacts",
    "evidence_limits"
  ],
  "properties": {
    "schema": {
      "const": "glaciereq.resume-master.v1"
    },
    "version": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "facts_invariant": {
      "const": true
    },
    "identity": {
      "type": "object",
      "required": [
        "name",
        "location",
        "email",
        "portfolio",
        "github",
        "role_labels"
      ]
    },
    "proof": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "evidence_state",
          "claim"
        ]
      }
    },
    "experience": {
      "type": "array",
      "minItems": 1
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "format",
          "bytes",
          "sha256",
          "state"
        ],
        "properties": {
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "evidence_limits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
